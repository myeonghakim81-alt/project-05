# Copy this file to .env and fill in your own Supabase project's values to
# switch learner-state storage from local-only to Supabase, and/or to enable
# live Gemini conversation (see docs/gemini.md — it's proxied through a
# Supabase Edge Function, so these are the only values the client needs;
# there is no separate Gemini key here).
# Leave both unset (or delete .env) to keep using local storage and scripted
# dialogues — the app works fully offline either way (see src/lib/storage.ts).
#
# Get these for free at https://supabase.com -> New project -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — see docs/google-tts.md. Leave unset to use the free but
# noticeably robotic on-device/browser voice instead of natural Neural2
# speech (web only for now).
EXPO_PUBLIC_GOOGLE_TTS_API_KEY=
EXPO_PUBLIC_GOOGLE_TTS_VOICE=en-US-Neural2-C
